{
  "name": "home-hub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "analyze": "cross-env ANALYZE=true vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "inspect:apartment": "node ./devtools/apartment-whitebox/generate-scene.mjs && vite --config ./devtools/apartment-whitebox/vite.config.mjs",
    "build:inspect:apartment": "node ./devtools/apartment-whitebox/generate-scene.mjs && vite build --config ./devtools/apartment-whitebox/vite.config.mjs",
    "test:inspect:apartment": "node ./devtools/apartment-whitebox/generate-scene.mjs && vitest run --config ./devtools/apartment-whitebox/vitest.config.mjs",
    "dev:apartment-canvas": "node ./devtools/apartment-whitebox/generate-scene.mjs && vite --config ./devtools/apartment-canvas-preview/vite.config.mjs",
    "build:apartment-canvas": "node ./devtools/apartment-whitebox/generate-scene.mjs && vite build --config ./devtools/apartment-canvas-preview/vite.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.2",
    "rollup-plugin-visualizer": "~5.12.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "vite": "^5.2.0",
    "vitest": "~3.2.7"
  },
  "dependencies": {
    "@threlte/core": "^7.3.0",
    "@threlte/extras": "^8.11.0",
    "d3-force": "^3.0.0",
    "lucide-svelte": "^1.0.1",
    "postprocessing": "^6.39.2",
    "qrcode": "^1.5.4",
    "simplex-noise": "^4.0.3",
    "three": "^0.170.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "svelte-preprocess@5.1.4": true
  }
}
