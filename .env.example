# Home Hub Configuration
# Copy this to .env and fill in your values
APP_ENV=development
LOCAL_IP=192.168.86.XXX        # Your PC's LAN IP (Sonos fetches TTS audio from here)
# Optional stable role emitted by pc_agent activity reports: desktop or latitude.
# HOME_HUB_AGENT_DEVICE=desktop

# SvelteKit static build directory, relative to project root.
FRONTEND_BUILD=frontend-svelte/build

# Hue Bridge
HUE_BRIDGE_IP=192.168.86.50
HUE_USERNAME=your-hue-bridge-username

# Sonos (auto-discovered by default, uncomment to override)
# SONOS_IP=192.168.86.XX

# TTS
TTS_VOICE=en-US-GuyNeural
# TTS announcement volume (0-100). Matches backend/config.py default; raise for
# a louder living-room (for example, game-day).
TTS_VOLUME=10

# Logging
LOG_LEVEL=INFO

# Morning Routine (uncomment and fill in to enable)
# Weather uses NWS API (api.weather.gov) — no key needed.
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# HOME_ADDRESS=123 Main St, Indianapolis, IN
# WORK_ADDRESS=456 Office Blvd, Indianapolis, IN
# MORNING_ROUTINE_HOUR=6
# MORNING_ROUTINE_MINUTE=40
# MORNING_VOLUME=10
# TIMEZONE=America/Indiana/Indianapolis

# Music Discovery (optional — enables recommendations)
# Get a free API key at https://www.last.fm/api/account/create
# LASTFM_API_KEY=your-lastfm-api-key

# Pi-hole DNS ad blocker (optional — enables network stats widget)
# Requires Pi-hole v6 running in Docker, see docker/pihole/setup.sh
# PIHOLE_API_URL=http://localhost:8080
# PIHOLE_API_KEY=your-pihole-admin-password

# Plant App integration (optional — enables /api/plants and the dashboard widget)
# PLANT_APP_API_URL=https://plant-api.example.com
# PLANT_APP_EMAIL=you@example.com
# PLANT_APP_PASSWORD=
# Default false — rejects http:// at boot. Set true ONLY if upstream lacks TLS.
# PLANT_APP_ALLOW_INSECURE=false

# Bar App integration (optional — enables /api/bar and the dashboard widget)
# BAR_APP_URL=http://192.168.1.50:8001

# Guest WiFi — populates the QR on the home dashboard and /guest landing page.
# Empty SSID renders a "not configured" state.
# GUEST_WIFI_SSID=
# GUEST_WIFI_PASSWORD=
# GUEST_WIFI_SECURITY=WPA  # WPA | WEP | nopass

# Game Day (optional)
# OPENAI_API_KEY=sk-your-key-here
# AI Personality / VibeRouter fallback parser. Deterministic rules run first;
# Anthropic is only used for ambiguous free-form vibe commands.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307
# ESPN_POLL_INTERVAL=5
# BIG_PLAY_YARD_THRESHOLD=20
# FIELD_GOAL_YARD_THRESHOLD=40
# |WPA| swing that triggers a momentum celebration on a non-scoring play.
# MOMENTUM_WPA_THRESHOLD=0.15

# Fauxmo Alexa integration — set to true to expose 7 virtual switches on the LAN
# that Alexa can discover for voice control ("Alexa, turn on gaming mode").
# FAUXMO_ENABLED=false

# API-key auth on write endpoints. When set, every POST/PUT/DELETE requires
# X-API-Key matching this value for external/non-bypassed callers. Localhost,
# configured TRUSTED_LAN_IPS, and private/LAN addresses use the ordinary
# require_api_key() bypass. When unset, non-bypassed writes return 503.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# HOME_HUB_API_KEY=
# Comma-separated IPs that bypass X-API-Key in addition to the private/LAN
# bypass (for example, an explicitly trusted non-private address).
# TRUSTED_LAN_IPS=

# Custom Alexa Skill — required when the Cloudflare Tunnel is up.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The tunnel proxy at 127.0.0.1:8002 injects X-Tunnel-Origin: cloudflare on
# every forwarded request; require_api_key then demands BOTH this token AND
# HOME_HUB_API_KEY. Tunnel-origin requests never receive the ordinary
# loopback/private-LAN bypass.
# HOME_HUB_SKILL_TOKEN=

# Legacy/dormant zone+posture → relax setting, pending #80. It remains for
# compatibility; do not treat it as an active bed-zone capability.
# ZONE_POSTURE_RULE_APPLY=true

# Deterministic couch-driven Relax atmosphere selection (#129/#130).
# Default false: decisions remain observable, ordinary Relax still applies.
# LIVING_ROOM_ATMOSPHERE_ENABLED=false

# Bounded auto-remediation (source-trust watchdog). Two-stage kill-switch:
# REMEDIATION_ENABLED turns on the subsystem (status endpoint + audit log);
# REMEDIATION_AUTONOMOUS additionally lets the remediator agent *execute*
# whitelisted fixes. With ENABLED=true + AUTONOMOUS=false the remediator is
# propose-only — it records what it would do and notifies, but mutates nothing.
# Ship propose-only; flip AUTONOMOUS to true only after the audit log shows
# clean proposals. Both default false (subsystem inert).
# REMEDIATION_ENABLED=false
# REMEDIATION_AUTONOMOUS=false
# Rate ceilings: at most N auto-executed fixes per rolling 24h, and a
# per-action cooldown (seconds) so the same fix can't repeat in a tight loop.
# REMEDIATION_MAX_AUTO_PER_DAY=6
# REMEDIATION_ACTION_COOLDOWN_SECONDS=1800

# MCP server target — override the Home Hub URL. Defaults to
# http://localhost:8000. Set this when the backend runs on another machine.
# NOTE: read directly via os.environ in backend/mcp_server.py — NOT a pydantic
# Settings field, so it must be a real environment variable; a value placed only
# in this .env file is ignored by the server. Set it in your shell/MCP env.
# HOME_HUB_URL=http://localhost:8000

# Sentry error reporting — create a Python/FastAPI project in your Sentry
# organization and paste its DSN here. When unset, sentry_sdk.init() runs
# with dsn=None and silently drops events. Free tier = 10k events/month.
# SENTRY_DSN=

# NotifierService — phone push via ntfy.sh. The topic name is the auth
# boundary on hosted ntfy.sh (anyone subscribed gets the messages), so
# treat it like an API key. Subscribe in the ntfy iOS/Android app at
# https://ntfy.sh/<your-topic>. When NTFY_TOPIC is unset, the desktop
# toast surface still works (via WS broadcast) but no phone push fires.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(24))"
# NTFY_TOPIC=
# Override only when self-hosting (e.g. http://192.168.86.210:8085). Default
# is the hosted ntfy.sh service.
# NTFY_SERVER=https://ntfy.sh
# #198 experimental camera challenger harness. No authority effects; false by default.
CAMERA_SHADOW_BAKEOFF_ENABLED=false
# First challenger: native OpenVINO YOLO26n-pose. Requires the bake-off gate above too.
CAMERA_SHADOW_YOLO_ENABLED=false
# CAMERA_SHADOW_YOLO_MODEL_PATH=/opt/home-hub/models/yolo26n-pose_openvino_model
CAMERA_SHADOW_YOLO_PERSON_CONFIDENCE=0.05
CAMERA_SHADOW_YOLO_KEYPOINT_CONFIDENCE=0.25
# Real challenger runtime also requires an explicit calibration label.
# CAMERA_SHADOW_CAPTURE_LABEL=normal-couch
CAMERA_SHADOW_CAPTURE_DIR=/tmp/homehub-camera-shadow
CAMERA_SHADOW_CAPTURE_MAX_RECORDS=1000

# Promoted Latitude authority gate (separate from shadow capture).
# Keep false until model + live validation are explicitly approved.
CAMERA_YOLO_AUTHORITY_ENABLED=false
# CAMERA_YOLO_AUTHORITY_MODEL_PATH=/opt/home-hub/models/yolo26n-pose_openvino_model
CAMERA_YOLO_AUTHORITY_PERSON_CONFIDENCE=0.25
CAMERA_YOLO_AUTHORITY_BLINDED_CONFIDENCE=0.01
CAMERA_YOLO_AUTHORITY_PRESENT_DWELL_FRAMES=3
