#!/bin/bash
# Pre-push hook — runs lint checks before allowing git push.
# Install: git config core.hooksPath .githooks

set -e

echo "=== Pre-push: Python lint ==="
python -m ruff check backend/ --quiet

echo "=== Pre-push: Change-scope validation plan ==="
python scripts/validate_change_scope.py

echo "=== Pre-push: All checks passed ==="
