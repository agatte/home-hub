{
  "mcpServers": {
    "home-hub": {
      "command": "python",
      "args": ["-m", "backend.mcp_server"]
    },
    "sqlite-home-hub": {
      "command": "python",
      "args": [
        "-c",
        "from mcp_server_sqlite import main; main()",
        "--db-path",
        "data/home_hub.db"
      ]
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server@latest"]
    },
    "git-home-hub": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server_git",
        "--repository",
        "."
      ]
    },
    "time": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server_time",
        "--local-timezone",
        "America/Indiana/Indianapolis"
      ]
    }
  }
}
