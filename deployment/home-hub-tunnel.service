# Home Hub Cloudflare Tunnel passthrough — systemd user unit.
#
# Sits between cloudflared and the main FastAPI backend on the Latitude.
# Cloudflared points its ingress at http://localhost:8002 (this service);
# this service injects X-Tunnel-Origin: cloudflare and forwards to
# 127.0.0.1:8000 (home-hub.service). Phase 5 Custom Alexa Skill flow:
#
#   Alexa → Lambda → cloudflared → :8002 (this) → :8000 (main backend)
#
# See backend/api/tunnel_proxy.py for the proxy itself.
#
# Install (one-time on the Latitude):
#   cp deployment/home-hub-tunnel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable home-hub-tunnel.service
#   systemctl --user start home-hub-tunnel.service
#
# Logs:
#   journalctl --user -u home-hub-tunnel.service -f

[Unit]
ConditionPathExists=!%h/.local/state/home-hub/travel-mode
ConditionPathExists=!%h/.local/state/home-hub/returning-home
Description=Home Hub Cloudflare Tunnel Proxy
# Wait until the main backend is ready — proxy returns 502 if upstream
# isn't listening, but starting in order avoids a startup-race blip.
After=network-online.target home-hub.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/home-hub
# Bind to localhost only — cloudflared connects locally; this port must
# never be reachable from the LAN or public internet.
ExecStart=%h/home-hub/venv/bin/python -m uvicorn backend.api.tunnel_proxy:app --host 127.0.0.1 --port 8002 --log-level info
Restart=always
RestartSec=5
Environment="PATH=%h/home-hub/venv/bin:/usr/bin"

[Install]
WantedBy=default.target
